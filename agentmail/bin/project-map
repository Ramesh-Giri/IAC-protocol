#!/usr/bin/env python3
"""Build a human-readable map of a code repository: every source file in a
folder tree with its one-line purpose and the files it links to.

Why this exists: Ramesh designs the architecture but no longer writes the code.
He wants a detailed map of the whole project that grows as agents work: each
file is documented the first time an agent touches it (IAC rule 28), and this
map shows the documented purpose, links and coverage, so undocumented files are
visible as gaps rather than hidden.

    project-map [--repo DIR] [--out-dir docs/map] [--roots lib functions/src ...]

Writes <out-dir>/PROJECT_MAP.md (tree, purposes, links, coverage per folder)
and <out-dir>/graph.json (nodes with purpose, edges = internal imports).
Purpose = the file's header doc comment (first sentence). Reads only; no
network; deterministic, so re-running after a change gives a minimal diff.
"""
from __future__ import annotations
import argparse, json, os, re, subprocess
from collections import defaultdict

EXTS = (".dart", ".ts", ".tsx", ".js", ".jsx", ".py", ".kt", ".swift")
SKIP = re.compile(r"(^|/)(build|node_modules|\.dart_tool|lib-scripts|generated|\.generated|Pods)/|\.(g|freezed|gr|config|mocks)\.dart$|\.d\.ts$")
NOISE = re.compile(r"GENERATED|DO NOT (MODIFY|EDIT)|ignore_for_file|eslint|@ts-|istanbul|coverage:|Copyright|SPDX|^!|prettier|tslint|pylint|noqa|@format", re.I)
DART_IMPORT = re.compile(r"""^\s*(?:import|export|part)\s+['"]([^'"]+)['"]""")
TS_IMPORT = re.compile(r"""(?:^\s*import\s[^'"]*?from\s+|^\s*export\s[^'"]*?from\s+|require\(\s*|^\s*import\s+)['"](\.{1,2}/[^'"]+)['"]""")
PY_IMPORT = re.compile(r"^\s*from\s+(\.+[\w.]*)\s+import")


def header_doc(lines, ext):
    """First sentence of the leading comment block / docstring, ignoring tooling noise."""
    text, i, n = [], 0, len(lines)
    while i < n and not lines[i].strip():
        i += 1
    if ext == ".py" and i < n and lines[i].lstrip().startswith(('"""', "'''")):
        q = lines[i].lstrip()[:3]
        body = lines[i].lstrip()[3:]
        while True:
            if q in body:
                text.append(body.split(q)[0]); break
            text.append(body); i += 1
            if i >= n: break
            body = lines[i]
    else:
        in_block = False
        for ln in lines[i:i + 60]:
            s = ln.strip()
            if in_block:
                if "*/" in s:
                    text.append(s.split("*/")[0].lstrip("* ")); in_block = False; continue
                text.append(s.lstrip("* ")); continue
            if s.startswith("/*"):
                in_block = "*/" not in s
                text.append(s[2:].split("*/")[0].lstrip("* ")); continue
            if s.startswith(("///", "//", "#")) and not s.startswith("#!"):
                text.append(s.lstrip("/#").strip()); continue
            if s == "" and text:
                continue
            break
    text = [t for t in (x.strip() for x in text) if t and not NOISE.search(t)]
    if not text:
        return None
    para = " ".join(text)
    m = re.match(r"(.+?[.!?])(\s|$)", para)
    return (m.group(1) if m else para)[:160]


def resolve(src, spec, ext, files, pkg):
    base = os.path.dirname(src)
    if ext == ".dart":
        if spec.startswith(f"package:{pkg}/"):
            cand = "lib/" + spec[len(f"package:{pkg}/"):]
        elif ":" in spec:
            return None
        else:
            cand = os.path.normpath(os.path.join(base, spec))
        return cand if cand in files else None
    if ext == ".py":
        dots = len(spec) - len(spec.lstrip("."))
        d = base
        for _ in range(dots - 1):
            d = os.path.dirname(d)
        mod = spec.lstrip(".").replace(".", "/")
        for c in (os.path.join(d, mod) + ".py", os.path.join(d, mod, "__init__.py")):
            c = os.path.normpath(c)
            if c in files:
                return c
        return None
    p = os.path.normpath(os.path.join(base, spec))
    p = re.sub(r"\.js$", "", p)
    for c in (p, *(p + e for e in (".ts", ".tsx", ".js", ".jsx")), *(os.path.join(p, "index" + e) for e in (".ts", ".tsx", ".js"))):
        if c in files:
            return c
    return None


def build(repo, roots):
    listed = subprocess.run(["git", "-C", repo, "ls-files", *roots], capture_output=True, text=True, check=True).stdout.splitlines()
    files = sorted(f for f in listed if f.endswith(EXTS) and not SKIP.search(f))
    fileset = set(files)
    pkg = "app"
    try:
        pkg = re.search(r"^name:\s*(\S+)", open(os.path.join(repo, "pubspec.yaml")).read(), re.M).group(1)
    except (OSError, AttributeError):
        pass
    purpose, links = {}, defaultdict(set)
    for f in files:
        ext = os.path.splitext(f)[1]
        try:
            lines = open(os.path.join(repo, f), encoding="utf-8", errors="replace").read().splitlines()
        except OSError:
            continue
        purpose[f] = header_doc(lines, ext)
        rx = DART_IMPORT if ext == ".dart" else PY_IMPORT if ext == ".py" else TS_IMPORT
        for ln in lines:
            m = rx.search(ln)
            if m:
                t = resolve(f, m.group(1), ext, fileset, pkg)
                if t and t != f:
                    links[f].add(t)
    used_by = defaultdict(set)
    for a, bs in links.items():
        for b in bs:
            used_by[b].add(a)
    return files, purpose, links, used_by


def folder_readme(repo, d):
    p = os.path.join(repo, d, "README.md")
    if not os.path.exists(p):
        return None
    for ln in open(p, encoding="utf-8", errors="replace"):
        s = ln.strip().lstrip("#").strip()
        if s and not s.startswith(("<!--", "|", "```")):
            return s[:140]
    return None


def render(repo, files, purpose, links, used_by):
    by_dir = defaultdict(list)
    for f in files:
        by_dir[os.path.dirname(f)].append(f)
    dirs = sorted(by_dir)
    total, documented = len(files), sum(1 for f in files if purpose.get(f))
    out = ["# Project map", "",
           "Generated by `agentmail/bin/project-map` from the code itself; do not edit by hand.",
           "Each file shows its purpose (from the file's header comment) and the project files it links to.",
           "`undocumented` marks a file no agent has documented yet (IAC rule 28: an agent documents a file the first time it touches it).", "",
           f"**Coverage: {documented} of {total} source files documented ({100 * documented // max(total, 1)}%).**", "",
           "| Folder | Files | Documented |", "|---|---|---|"]
    for d in dirs:
        fs = by_dir[d]
        k = sum(1 for f in fs if purpose.get(f))
        out.append(f"| `{d}` | {len(fs)} | {k} |")
    out += ["", "## Tree", ""]
    for d in dirs:
        depth = d.count("/")
        summary = folder_readme(repo, d)
        out.append(f"{'  ' * depth}- **{os.path.basename(d) or d}/**" + (f" — {summary}" if summary else "") + f"  `{d}`")
        for f in by_dir[d]:
            p = purpose.get(f)
            line = f"{'  ' * (depth + 1)}- `{os.path.basename(f)}` — " + (p if p else "_undocumented_")
            ls = sorted(links.get(f, ()))
            if ls:
                line += " → " + ", ".join(f"`{x}`" for x in ls[:8]) + (f" (+{len(ls) - 8})" if len(ls) > 8 else "")
            if used_by.get(f):
                line += f" · used by {len(used_by[f])}"
            out.append(line)
    return "\n".join(out) + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--repo", default=".")
    ap.add_argument("--out-dir", default="docs/map")
    ap.add_argument("--roots", nargs="*", default=["lib", "functions/src"])
    a = ap.parse_args()
    files, purpose, links, used_by = build(a.repo, a.roots)
    od = os.path.join(a.repo, a.out_dir)
    os.makedirs(od, exist_ok=True)
    open(os.path.join(od, "PROJECT_MAP.md"), "w").write(render(a.repo, files, purpose, links, used_by))
    graph = {"nodes": [{"id": f, "purpose": purpose.get(f)} for f in files],
             "edges": [{"from": x, "to": y} for x in sorted(links) for y in sorted(links[x])]}
    json.dump(graph, open(os.path.join(od, "graph.json"), "w"), indent=1)
    documented = sum(1 for f in files if purpose.get(f))
    print(f"{od}/PROJECT_MAP.md: {len(files)} files, {documented} documented, {len(graph['edges'])} links")


if __name__ == "__main__":
    main()
