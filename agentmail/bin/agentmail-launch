#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""agentmail-launch — start every seat in the roster, one named terminal each,
with the model and permission mode that seat was assigned.

    agentmail-launch [--all | --seat ID ...] [--overseer] [--apply]
                     [--terminal auto|terminal|iterm|tmux|print] [-d MAIL_DIR]

DRY RUN BY DEFAULT. It prints the exact command it would run for each seat and
changes nothing until --apply.

WHY THIS EXISTS
    Everything else in this toolkit is durable — mail, roster, board, repos.
    Sessions are the one disposable part, which means they get started and
    restarted constantly: after a crash, after a laptop reboot, after a model
    change, after `agentmail-adopt` moved a directory out from under them.
    Doing that by hand means retyping a --model flag and a boot prompt per
    project and getting a terminal called "bash" seven times.

WHAT IT GUARANTEES
    * Each child launches in ITS OWN home directory, with the model the roster
      assigned it — the roster is intent, and this is what turns intent into
      the process the dashboard will later observe.
    * Each terminal is named after its seat, because seven identical windows
      is how people end up typing into the wrong agent.
    * The first thing every child is told is to arm its mail watcher. A seat
      that skips this looks alive and is deaf, which is the most common fault
      in a new network.
    * THE OVERSEER NEVER GETS --dangerously-skip-permissions. It is the seat a
      human talks to and the one that approves things; it prompts, always, and
      this tool will refuse to do otherwise.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from iac import local_config, local_site as resolve_site, valid_id
import model_guard as _mg

TOOL_VERSION = "1.1.0"

# ---------------------------------------------------------------------------
# Advisory model guard: report and log the roster's own choice without substituting it.
# Site-specific authorization history and model policy live in ignored local/.
# Catalogue failures, guard exceptions and empty survivor sets are reported as findings;
# they never block a launch or grant permission to change the approved roster model.
# ---------------------------------------------------------------------------


def _load_catalogues() -> dict[str, set[str] | None]:
    """{"codex-cli": {...ids...} | None, "claude-code": {...ids...} | None}. Reuses
    catalog-check's own loaders (not duplicated) via importlib, since that file has no .py
    extension. Any failure here degrades to {both: None} -- the guard then skips the
    allowlist check entirely rather than raising or reporting a false "nothing is valid"."""
    try:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        cc_path = str(Path(__file__).resolve().with_name("catalog-check"))
        spec = importlib.util.spec_from_file_location("catalog_check", cc_path,
                                                        loader=SourceFileLoader("catalog_check", cc_path))
        catalog_check = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(catalog_check)
        codex_ids, _ = catalog_check.load_codex()
        claude_ids, _ = catalog_check.load_claude()
        return {"codex-cli": codex_ids, "claude-code": claude_ids}
    except Exception:
        return {"codex-cli": None, "claude-code": None}


def guard_report(seat: dict) -> dict:
    """Advisory guard opinion for one roster seat's OWN (runtime, model) choice. Never
    raises -- any failure anywhere in here degrades to a report that says so, with the
    roster's own value as the (only) candidate, so a caller can always proceed. Returns:
        {"decision": model_guard.Decision | None, "mismatch": bool, "error": str | None}
    `mismatch` is True only when the guard is confident (no error) AND the roster's own model
    is not among the survivors -- i.e. the guard would have removed the very thing the roster
    currently launches with.
    """
    try:
        runtime = seat.get("runtime") or "claude-code"
        model = seat.get("model")
        pinned = seat.get("role") in ("parent", "council")
        if not model:
            return {"decision": None, "mismatch": False, "error": "seat has no model pinned; nothing to check"}
        if _CATALOGUE_CACHE[0] is None:
            _CATALOGUE_CACHE[0] = _load_catalogues()
        catalogues = _CATALOGUE_CACHE[0]
        candidates = [_mg.Candidate(runtime=runtime, model=model)]
        decision = _mg.resolve(
            candidates,
            task_kind=None,                 # no kind classifier in the launcher; Laya is nowhere near this path
            task_text=seat.get("description") or "",
            host_tool_required=bool(seat.get("host_tool")),
            verified_ids=catalogues,
            pinned=pinned,
        )
        mismatch = (not pinned) and not any(c.runtime == runtime and c.model == model for c in decision.candidates)
        return {"decision": decision, "mismatch": mismatch, "error": None}
    except Exception as exc:  # the guard must NEVER be why a launch fails
        return {"decision": None, "mismatch": False, "error": f"guard error, degraded to roster value: {exc!r}"}


_CATALOGUE_CACHE: list = [None]  # loaded once per process, lazily, on first guard_report() call


def _guard_summary_line(report: dict) -> str:
    """One line for the plan output. Never the reason a plan fails to print."""
    try:
        if report["error"]:
            return f"unavailable ({report['error']})"
        if report["decision"] is None:
            return "no opinion"
        if report["mismatch"]:
            return ("MISMATCH -- the guard would remove the roster's own model choice: "
                    + "; ".join(report["decision"].reasons))
        return "OK -- " + "; ".join(report["decision"].reasons)
    except Exception as exc:
        return f"unavailable (guard summary itself failed: {exc!r})"


def _print_full_roster_guard_audit(agents: dict) -> None:
    """Report advisory mismatches across all seats, including homes absent on this machine.

    Missing models and guard errors are unknown findings, never successful checks.
    This function only prints; it never changes configuration or blocks a launch.
    """
    try:
        print("guard audit — full roster (every seat, home directory or not)")
        mismatches = []
        checked = 0
        for sid, meta in agents.items():
            seat = dict(meta)
            seat["id"] = sid
            report = guard_report(seat)
            if report["error"] is None:
                checked += 1
            if report["mismatch"]:
                mismatches.append((sid, seat.get("runtime") or "claude-code", seat.get("model"), report["decision"].reasons))
        print(f"  seats checked: {checked} of {len(agents)} (others: no model pinned, or a guard error, both counted as no-opinion, never as a pass)")
        print(f"  mismatches: {len(mismatches)}")
        for sid, rt, model, reasons in mismatches:
            print(f"    {sid}  runtime={rt}  model={model}")
            for r in reasons:
                print(f"        - {r}")
        print()
    except Exception as exc:
        print(f"  guard audit failed to run ({exc!r}) -- this affects reporting only, not any launch\n")


def _log_launch_decision(seat: dict, mail_root: str) -> None:
    """Append one decision-log line for a seat that was just (attempted to be) launched.
    Logs the ACTUAL choice used -- always seat['model'], unchanged, since the guard is
    advisory at this integration point -- alongside the guard's opinion, so a later reader can
    see every case where they disagreed, not just today's (expected empty) diff. Never raises:
    a logging failure must not be why a launch reports as failed."""
    try:
        report = guard_report(seat)
        runtime = seat.get("runtime") or "claude-code"
        model = seat.get("model")
        final_choice = {"runtime": runtime, "model": model} if model else None
        decision = report["decision"]
        if decision is None:
            # No decision object (no model pinned, or the guard itself errored) -- still log
            # a line, per "one line per launch, even when it falls back", using an empty
            # placeholder decision so the schema stays uniform.
            decision = _mg.Decision(candidates=[], candidates_in=[], reasons=[report["error"] or "no model pinned"],
                                     locked_audit=False, locks_fired=[],
                                     brief_hash=hashlib.sha256((seat.get("description") or "").encode("utf-8")).hexdigest())
        log_path = os.path.join(mail_root, "model-decisions.jsonl")
        _mg.write_decision_log(log_path, decision, task_id=seat["id"], seat=seat["id"],
                                task_kind=None, pinned=seat.get("role") in ("parent", "council"),
                                final_choice=final_choice)
    except Exception:
        pass  # logging must never be why a launch fails or reports wrong

BOOT_CHILD = ("Arm your mail watcher (persistent) FIRST, then check your mail "
              "and get oriented.")
BOOT_OVERSEER = "You're my overseer — check your mail and get oriented."


def find_mail_root(start: str) -> str | None:
    d = os.path.abspath(start)
    while True:
        cand = os.path.join(d, ".agent-mail")
        if os.path.isdir(cand):
            return cand
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def _resend_boot_if_idle(window: str, prompt: str, wait: int = 12) -> bool:
    """Submit the boot prompt if the freshly-launched pane is sitting idle.

    An agent CLI handed its instruction as argv does not always execute it; the
    seat then shows an empty prompt and looks hung to the operator. But some
    runtimes DO honour argv, and blindly typing the prompt again would submit it
    twice. So decide from the pane itself: a working agent renders an interrupt
    hint ("esc to interrupt" / "to interrupt") on its current status line.
    Use the same capture and trust guards for literal text and subsequent keys.
    """
    try:
        return _submit_until_working(window, boot_prompt=prompt, capture_tries=wait)
    except (OSError, subprocess.SubprocessError):
        return False


# Exact cwd supplied to spawn, keyed by its unchanged tmux target.
_LAUNCH_CWDS: dict[str, str] = {}


def _startup_folder_matches(pane: str, cwd: str | None) -> bool:
    # Preserve every path byte, including leading/trailing whitespace.
    lines = [line for line in pane.splitlines() if line.strip()]
    return bool(cwd and len(lines) in (3, 5) and lines[0].lower() == "trust this folder?"
                and lines[-1].lower() == "trust and continue" and lines[1] == cwd
                and (len(lines) == 3 or (lines[2].lower() == "repository root:" and lines[3] == cwd)))


# Known idle suffixes only; a glyph by itself never proves input readiness.
_IDLE_SCREENS = {
    "claude-code": (r"─{3,}", r"❯(?: (?P<text>.*))?", r"─{3,}", r"\? for shortcuts"),
    "codex-cli": (r"›(?: (?P<text>.*))?", r"\? for shortcuts"),
}


def _startup_idle_matches(pane: str, prompt: str | None = None) -> bool:
    lines = [line.strip() for line in pane.splitlines() if line.strip()]
    for patterns in _IDLE_SCREENS.values():
        if len(lines) < len(patterns):
            continue
        matches = [re.fullmatch(pattern, line)
                   for pattern, line in zip(patterns, lines[-len(patterns):])]
        if all(matches):
            text = next(match.groupdict()["text"] for match in matches if "text" in match.groupdict())
            # After our paste, only that exact pending prompt may be submitted.
            if not text or text == prompt:
                return True
    return False


def _submit_until_working(window: str, tries: int = 4, *,
                          boot_prompt: str | None = None, capture_tries: int = 16) -> bool:
    """Press Enter until the pane shows the agent working.

    A long typed prompt arrives as a bracketed paste; Codex can swallow the
    first Enter (still booting, or treating it as part of the paste), leaving
    the instruction sitting unsent in the input box. Never assume one Enter landed;
    verify the current status line, retrying a few times.
    Optional boot text is typed once at a known idle composer, then recaptured before Enter.
    """
    import time
    folder_selected = False
    pending_prompt = boot_prompt
    for _ in range(tries):
        time.sleep(2)
        submitted = False
        # One guard for every capture, before and after submitting the prompt.
        for _ in range(capture_tries):
            try:
                capture = subprocess.run(["tmux", "capture-pane", "-p", "-t", window],
                                         capture_output=True, text=True, timeout=10)
                pane = capture.stdout if capture.returncode == 0 else ""
            except (OSError, subprocess.SubprocessError):
                pane = ""
            if not pane or not pane.strip():
                folder_selected = False
                time.sleep(1)
                continue  # Unknown readiness must never result in a key press.
            folder_matches = _startup_folder_matches(pane, _LAUNCH_CWDS.get(window))
            if not folder_matches:
                folder_selected = False
            if folder_matches:
                # Select and confirm on separate successful captures, guarding both keys.
                action = "Enter" if folder_selected else "Home"
                subprocess.run(["tmux", "send-keys", "-t", window, action], timeout=10)
                folder_selected = action == "Home"
            elif re.fullmatch(r"(?:esc to interrupt|to interrupt|"
                              r"(?:[•✻✽✶✳✢*·]\s+[^()]+|Working)\s*"
                              r"\([^()]*\besc to interrupt\))",
                              pane.rstrip().splitlines()[-1].strip()):
                return True
            elif not _startup_idle_matches(pane, pending_prompt):
                subprocess.run(["tmux", "send-keys", "-t", window, "Escape"], timeout=10)
                tail = pane.rstrip().splitlines()[-3:]
                print(f"WARNING: {window.rsplit(':', 1)[-1]}: unknown startup screen; "
                      f"hooks stay human-only; last 3 lines: {tail!r}", file=sys.stderr)
                return False
            elif boot_prompt is not None:
                if _startup_idle_matches(pane):
                    subprocess.run(["tmux", "send-keys", "-t", window, "-l", boot_prompt],
                                   check=True, timeout=10)
                boot_prompt = None  # Recapture and recheck readiness before pressing Enter.
            elif not submitted:
                subprocess.run(["tmux", "send-keys", "-t", window, "Enter"], timeout=10)
                submitted = True
            time.sleep(1)
    print(f"WARNING: {window}: startup readiness unknown after {tries} attempts; trust withheld",
          file=sys.stderr)
    return False


def _self_check_startup_trust() -> None:
    import contextlib
    import io
    from unittest.mock import patch

    cwd = "/tmp/launchtrust-fixture"
    folder = lambda path: f"Trust this folder?\n{path}\nTrust and continue"
    row = "claude-mem@claude-mem-local:hooks/codex-hooks.json:pre_tool_use:0:0 sha256:" + "a" * 64
    listing = f"5 hooks need review\n{row}\nt trust all"
    rejected = [
        "Hooks need review\n5 hooks are new or changed.",
        "Modified hooks since last trusted - review required",
        listing, listing.replace("sha256:", "sha256:0", 1),
        listing.replace("claude-mem-local", "unknown-plugin", 1),
        listing.replace("5 hooks", "6 hooks"), listing.replace(row, ""),
        listing + "\nunknown additional hook", listing.replace(row, "evil!" + row),
        listing.replace(":0:0 ", ":0:0!evil "),
        listing + "\n6 hooks need review", listing + "\n5 hooks need review",
        listing + "\n??? additional hook with no parseable identity", listing + "\n" + row,
        "5 hooks need review\nt trust all\nPrevious status: esc to interrupt",
        "5 hooks need\nreview\nt trust all", "5 hooks need revie\nt trust all",
        "9" * 5000 + " hooks need review\nt trust all",
        "TRUST these\nHOOKS", "changed\nhook", "new hook",
        folder(cwd + "-other"), folder(cwd + "/child"), folder(cwd + "/link"),
        folder(cwd + "/../outside"), "Trust this folder?", folder(cwd + " "),
        folder(" " + cwd), folder(cwd + "/"), folder(cwd[:12] + "..."),
        folder(cwd[:12] + "\n" + cwd[12:]), folder(cwd) + "\n/etc",
    ]
    for target in ('"/etc"', "../launchtrust-fixture", "[unknown target]", '"' + cwd + '"', cwd + " "):
        rejected.append(f"Trust this folder?\n{target}\nRepository root:\n{cwd}\nTrust and continue")
    rejected.append(f"Trust this folder?\n{cwd}\nRepository root:\n{cwd} \nTrust and continue")
    rejected += [
        "Hooks\nneed\nreview\n\n› Trust all\n  Exit",
        "Trust this\nfolder?\n/tmp/unapproved\nTrust and continue\n›",
        "Hooks pending approval\n\nhook row\n\n› Trust all\n  Exit",
        "Choose an option\n› Continue\n  Cancel", "›", "normal idle prompt",
        "────────\n❯\n────────", "›\n? for shortcut",
        "Previous status: esc to interrupt", "esc to interrupt\nnormal idle prompt",
        "The prompt mentions esc to interrupt",
    ]
    claude = "────────\n❯\n────────\n  ? for shortcuts\n"
    codex = "› \n\n  ? for shortcuts\n"
    assert not _startup_folder_matches(folder(cwd), None)
    assert not _startup_idle_matches("normal idle prompt")

    def check(captures, expected_keys, expected_result, warning_count, entry="submit"):
        index, keys = 0, []
        def run(args, **kwargs):
            nonlocal index
            if "capture-pane" in args:
                capture = captures[min(index, len(captures) - 1)]
                index += 1
                if isinstance(capture, Exception):
                    raise capture
                if isinstance(capture, subprocess.CompletedProcess):
                    return capture
                return subprocess.CompletedProcess(args, 0, stdout=capture)
            if "send-keys" in args:
                keys.append(args[-1])
            return subprocess.CompletedProcess(args, 0)
        with patch.dict(_LAUNCH_CWDS, {"fixture": cwd}), \
                patch.object(subprocess, "run", side_effect=run), patch("time.sleep"), \
                contextlib.redirect_stderr(io.StringIO()) as warnings:
            if entry == "spawn":
                assert spawn("tmux", "fixture", "cli 'boot prompt'")[0]
            elif entry == "resend":
                assert _resend_boot_if_idle("fixture", "boot prompt", wait=16) == expected_result
            else:
                assert _submit_until_working("fixture", tries=1) == expected_result
        assert keys == expected_keys, (captures, keys)
        warning = warnings.getvalue()
        assert warning.count("WARNING:") == warning_count, warning
        if "Escape" in expected_keys:
            assert "fixture" in warning and "last 3 lines:" in warning, warning
            rejected_pane = captures[min(index, len(captures)) - 1]
            assert repr(rejected_pane.rstrip().splitlines()[-3:]) in warning, warning
        assert 1 <= index <= (64 if entry != "submit" else 16), index
        return index

    timeout = subprocess.TimeoutExpired("capture-pane", 10)
    failed = subprocess.CompletedProcess([], 1, stdout=codex)
    count_only = "5 hooks need review\nt trust all"
    working = "• Working (1s • esc to interrupt)"
    for entry in ("submit", "resend", "spawn"):
        for pane in rejected:
            check([pane, working], ["Escape"], False, 1, entry)
        for unavailable in ("", " \n", timeout, OSError("capture failed"), failed):
            assert check([unavailable], [], False, 1, entry) == (
                16 if entry == "submit" else 48 if entry == "spawn" else 64)
            check([unavailable, count_only], ["Escape"], False, 1, entry)
        check(["", timeout, failed, working], [], True, 0, entry)
        check(["older transcript\n" + working + "\n  "], [], True, 0, entry)
        for idle in (claude, codex):
            pending = idle.replace("❯", "❯ boot prompt").replace("› ", "› boot prompt")
            wrong_text = pending.replace("boot prompt", "unrecognized text")
            check([wrong_text], ["Escape"], False, 1, entry)
            keys = ["Enter"] if entry == "submit" else ["boot prompt", "Enter"]
            check([idle] + ([] if entry == "submit" else [pending]) + [working],
                  keys, True, 0, entry)
            check([idle, count_only], keys[:1] + ["Escape"], False, 1, entry)
            if entry != "submit":
                check([pending, pending, working], ["Enter"], True, 0, entry)
                # A swallowed Enter is retried without retyping our boot text.
                captures_per_try = 12 if entry == "spawn" else 16
                check([idle] + [pending] * captures_per_try + [working],
                      ["boot prompt", "Enter", "Enter"], True, 0, entry)
                check([folder(cwd), folder(cwd), idle, pending, working],
                      ["Home", "Enter", "boot prompt", "Enter"], True, 0, entry)
        for pane in (folder(cwd), f"Trust this folder?\n{cwd}\nRepository root:\n{cwd}\nTrust and continue"):
            check([pane, pane, working], ["Home", "Enter"], True, 0, entry)
            check([pane, count_only], ["Home", "Escape"], False, 1, entry)
            check([pane, failed], ["Home"], False, 1, entry)
        check([codex] + [""] * 14 + [count_only],
              (["Enter"] if entry == "submit" else ["boot prompt"]) + ["Escape"], False, 1, entry)



def applescript_quote(s: str) -> str:
    return s.replace("\\", "\\\\").replace('"', '\\"')


def build_command(seat: dict, mail_root: str) -> str:
    """The shell one-liner for one seat. Nothing here is implicit: the model,
    the permission mode and the boot prompt are all visible in the command, so
    what you read in the dry run is exactly what the process will show in `ps`
    — and exactly what the dashboard compares against the roster."""
    sid = valid_id(seat["id"])
    runtime = seat.get("runtime") or "claude-code"
    parent = seat.get("role") == "parent"
    prompt = (f"You are IAC seat {sid}, role {seat.get('role', 'child')}. "
              f"Mail root: {mail_root}. Helpers: {Path(__file__).resolve().parent}. "
              "Read roster.json for your project authority and delegation. "
              "Product requirements and technical implementation have separate owners. "
              "Research/attachments are context, not authorization to implement. "
              "Reply using --in-reply-to with the incoming message ID. "
              "Use --no-reply for acknowledgements and final responses. "
              + (BOOT_OVERSEER if parent else BOOT_CHILD))
    if runtime == "claude-code":
        # Name the session after its SEAT. Without --name, Claude Code labels every
        # session by its working directory, so all seats sharing one repo show up
        # under the same repository name.
        parts = ["claude", "--name", sid]
        if seat.get("model"):
            parts += ["--model", seat["model"]]
        if seat.get("_skip_permissions") and not parent:
            # Use the configured unattended worker mode only when explicitly requested.
            # Runtime and operating-system safeguards remain independently effective.
            parts += ["--permission-mode", "auto"]
        if not parent:
            # Decision questions go to the overseer by mail.
            # Removing the question tool does not remove OS/runtime permission prompts.
            # Subagent access requires an explicit roster opt-in.
            blocked = ["AskUserQuestion"]
            if not seat.get("allow_subagents"):
                blocked.append("Agent")
            parts += ["--disallowedTools", *blocked]
            # A child's cwd is its project sub-repo, but it must read the shared mail
            # root and these helpers, which live in the org root above it. Grant it.
            parts += ["--add-dir", str(Path(mail_root).resolve().parent)]
            # Leased worktrees can live outside the project and mail directories.
            # Directory grants remain subject to effective runtime and host policy.
            treehouse_root = Path(
                os.environ.get("TREEHOUSE_ROOT", Path.home() / ".treehouse")
            )
            if treehouse_root.exists():
                parts += ["--add-dir", str(treehouse_root)]
        parts.append(prompt)
    elif runtime == "codex-cli":
        if seat.get("_skip_permissions"):
            raise ValueError("Codex keeps its sandbox; use normal permissions for this seat")
        # The interactive supervisor retains approvals; unattended workers never prompt.
        # Both profiles retain the sandbox and remain subject to host policy.
        approval = "on-request" if parent else "never"
        parts = ["codex", "--sandbox", "workspace-write", "--ask-for-approval", approval,
                 "--add-dir", mail_root]
        # Unattended workers use shell mail polling and do not drive the operator's desktop.
        # Disable GUI plugins for this seat without changing the human's global configuration.
        if not parent:
            for plugin in ("computer-use@openai-bundled", "unified-computer-use@openai-bundled",
                           "browser@openai-bundled"):
                parts += ["-c", f'plugins."{plugin}".enabled=false']
        # Apply only task-scoped write grants recorded in the approved roster.
        for extra in seat.get("add_dirs", []):
            parts += ["--add-dir", extra]
        # Use explicit roster reasoning effort rather than assuming a runtime default.
        if seat.get("effort"):
            parts += ["-c", f'model_reasoning_effort="{seat["effort"]}"']
        # Socket access is enabled only by the roster's explicit network setting.
        if seat.get("network"):
            parts += ["-c", "sandbox_workspace_write.network_access=true"]
        if seat.get("model"):
            parts += ["--model", seat["model"]]
        # Codex has no persistent Monitor tool, so "arm your watcher" made it reach
        # for a terminal window. Tell it how mail works for it instead.
        parts.append(prompt if parent else prompt + (
            " NOTE FOR CODEX: you have no background watcher tool. Do NOT open any"
            " terminal or app. Read mail with the shell command"
            f" {Path(__file__).resolve().with_name('mail-read')} {sid} -d {mail_root}"
            " at start and after each step; the overseer prompts you when new mail arrives."))
    else:
        custom = seat.get("command")
        if parent or seat.get("_skip_permissions"):
            raise ValueError("custom runtimes require a prompted worker seat; configure its CLI safeguards explicitly")
        if not isinstance(custom, list) or not custom or not all(isinstance(x, str) for x in custom) or not any("{prompt}" in x for x in custom):
            raise ValueError(f"runtime {runtime}: provide a command argv array containing {{prompt}}")
        parts = [x.replace("{prompt}", prompt).replace("{model}", seat.get("model") or "") for x in custom]
    runner = str(Path(__file__).resolve().with_name("agentmail-run"))
    site_args = ["--site", seat["_local_site"]] if seat.get("_local_site") else []
    parts = [sys.executable, runner, "--seat", sid, "-d", mail_root, *site_args, "--", *parts]
    launch = " ".join(shlex.quote(p) for p in parts)
    return f"cd {shlex.quote(seat['home'])} && {launch}"


def spawn(kind: str, title: str, command: str, session: str | None = None) -> tuple[bool, str]:
    if kind == "terminal":
        script = (f'tell application "Terminal"\n'
                  f'  activate\n'
                  f'  do script "{applescript_quote(command)}"\n'
                  f'  set custom title of front window to "{applescript_quote(title)}"\n'
                  f'end tell')
    elif kind == "iterm":
        script = (f'tell application "iTerm"\n'
                  f'  create window with default profile\n'
                  f'  tell current session of current window\n'
                  f'    set name to "{applescript_quote(title)}"\n'
                  f'    write text "{applescript_quote(command)}"\n'
                  f'  end tell\n'
                  f'end tell')
    elif kind == "tmux":
        try:
            # Target the requested project session rather than whichever session is current.
            target = title
            if session:
                if subprocess.run(["tmux", "has-session", "-t", f"={session}"],
                                  capture_output=True, timeout=10).returncode != 0:
                    subprocess.run(["tmux", "new-session", "-d", "-s", session],
                                   check=True, timeout=15)
                # Exact session plus a trailing colon avoids window-prefix ambiguity.
                subprocess.run(["tmux", "new-window", "-t", f"={session}:", "-n", title, command],
                               check=True, timeout=15)
                # Session-qualified, so capture-pane/send-keys cannot hit a
                # same-named window in another session.
                target = f"{session}:{title}"
            else:
                subprocess.run(["tmux", "new-window", "-n", title, command], check=True, timeout=15)
            # The boot prompt is passed as argv to the agent CLI, but it does not
            # reliably auto-submit -- the seat then sits at an empty prompt and
            # reads as "stuck" to whoever is watching, when in truth nothing was
            # ever sent.
            #
            # Re-send it ONLY if the pane is actually idle. Sending it
            # unconditionally would double-submit on every seat where argv DID
            # work; deciding from the pane's own state is the check whose subject
            # is the thing at risk.
            # spawn() receives the assembled shell line, not the prompt; the boot
            # prompt is its final quoted argument (build_command appends it last).
            try:
                boot = shlex.split(command)[-1]
            except Exception:
                boot = ""
            if boot:
                _resend_boot_if_idle(target, boot)
            return True, "tmux window" + (f" in session {session}" if session else "")
        except (OSError, subprocess.SubprocessError) as exc:
            return False, str(exc)
    else:
        return False, f"unknown terminal kind: {kind}"

    try:
        p = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=30)
        return (p.returncode == 0), (p.stderr.strip() or "ok")
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)


def detect_terminal() -> str:
    if platform.system() != "Darwin":
        return "tmux" if os.environ.get("TMUX") else "print"
    if os.environ.get("TERM_PROGRAM") == "iTerm.app":
        return "iterm"
    return "terminal"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="agentmail-launch",
        description="Start roster seats in named terminals. Dry run by default.")
    ap.add_argument("-d", "--mail-root", help="the .agent-mail directory (default: found by walking up)")
    ap.add_argument("--seat", action="append", default=[], help="launch only this seat (repeatable)")
    ap.add_argument("--all", action="store_true", help="launch every seat in the roster")
    ap.add_argument("--overseer", action="store_true", help="include the overseer (off by default)")
    ap.add_argument("--site", help="local site; required for ambiguous federated rosters")
    ap.add_argument("--terminal", default="auto",
                    choices=["auto", "terminal", "iterm", "tmux", "print"],
                    help="how to open each session (default: auto-detect)")
    ap.add_argument("--skip-permissions", action="store_true",
                    help="run CHILD seats with --dangerously-skip-permissions (never the overseer)")
    ap.add_argument("--apply", action="store_true", help="actually launch (otherwise: print the plan)")
    ap.add_argument("--self-check", action="store_true", help="check startup trust matching offline; launch nothing")
    args = ap.parse_args(argv)

    if args.self_check:
        _self_check_startup_trust()
        print("startup trust self-check: passed")
        return 0

    mail_root = os.path.abspath(args.mail_root) if args.mail_root else find_mail_root(os.getcwd())
    if not mail_root or not os.path.isdir(mail_root):
        print("agentmail-launch: no .agent-mail found. Run this from inside your org root, "
              "or pass -d <path>.", file=sys.stderr)
        return 2
    roster_path = os.path.join(mail_root, "roster.json")
    try:
        with open(roster_path, encoding="utf-8") as roster_file:
            roster = json.load(roster_file)
    except (OSError, ValueError) as exc:
        print(f"agentmail-launch: cannot read {roster_path}: {exc}", file=sys.stderr)
        return 2

    agents = roster.get("agents") or {}
    try:
        local_site = resolve_site(mail_root, roster, args.site)
        homes = local_config(mail_root).get("homes", {})
    except (OSError, ValueError) as exc:
        ap.error(str(exc))
    if len(roster.get("sites", {})) > 1 and not local_site:
        ap.error("set --site, AGENTMAIL_SITE, or local.json.site; roster ownership does not identify this machine")
    if set(args.seat) - set(agents):
        ap.error("unknown requested seat")

    chosen = []
    for sid, meta in agents.items():
        if args.seat and sid not in args.seat:
            continue
        if not args.seat and not args.all:
            continue
        if meta.get("site") and local_site and meta.get("site") != local_site:
            if sid in args.seat:
                ap.error(f"{sid} belongs to another site; ask its overseer")
            continue                      # another machine's seat: not ours to start
        if meta.get("role") == "parent" and not (args.overseer or sid in args.seat):
            continue
        if meta.get("role") == "council":
            if sid in args.seat:
                ap.error(f"{sid} is advisory; use mail-bridge with a read-only runtime")
            print(f"  skipping {sid}: advisory council seats use mail-bridge with a read-only runtime")
            continue
        home = homes.get(sid) or meta.get("home") or ""
        if not os.path.isdir(home):
            if sid in args.seat:
                ap.error(f"{sid}: home does not exist here: {home or '(unset)'}")
            print(f"  skipping {sid}: home does not exist here: {home or '(unset)'}")
            continue
        seat = dict(meta)
        seat["home"] = str(Path(home).resolve())
        seat["id"] = sid
        seat["_local_site"] = local_site
        seat["_skip_permissions"] = bool(args.skip_permissions and meta.get("role") != "parent")
        chosen.append(seat)

    # Validate every command before opening any terminal.
    try:
        for seat in chosen:
            build_command(seat, mail_root)
    except ValueError as exc:
        ap.error(str(exc))

    if not chosen:
        print("nothing to launch. Use --all, or --seat <id>, and check the roster's homes exist here.")
        return 0

    kind = detect_terminal() if args.terminal == "auto" else args.terminal
    print(f"mail root    {mail_root}")
    print(f"terminals    {kind}" + ("   (auto-detected)" if args.terminal == "auto" else ""))
    print(f"seats        {len(chosen)}\n")

    for seat in sorted(chosen, key=lambda s: (s.get("role") != "parent", s["id"])):
        cmd = build_command(seat, mail_root)
        flag = " · unattended" if seat["_skip_permissions"] else " · prompts"
        print(f"  {seat['id']}   [{seat.get('model') or 'default model'}{flag}]")
        print(f"      {cmd}")
        print(f"      guard: {_guard_summary_line(guard_report(seat))}\n")

    if args.all:
        _print_full_roster_guard_audit(agents)

    if any(s["_skip_permissions"] for s in chosen):
        print("  NOTE: --dangerously-skip-permissions is set for the child seats above. Those")
        print("        sessions will act without asking, and the only thing between them and")
        print("        anything destructive is the escalation ladder written in their CLAUDE.md.")
        print("        The overseer always prompts; this tool will not do otherwise.\n")

    if kind == "print" or not args.apply:
        if not args.apply:
            print("dry run — nothing was launched. Re-run with --apply.")
        return 0

    ok = 0
    for seat in sorted(chosen, key=lambda s: (s.get("role") != "parent", s["id"])):
        # A seat added to roster.json but never `agentmail-init`ed has no maildir.
        # agentmail-run then exits immediately and the seat is DEAD -- while this
        # tool would otherwise report a successful launch. Refuse loudly and say the
        # exact command that fixes it: creating the maildir here would paper over
        # a setup step the operator should know they skipped.
        seat_maildir = os.path.join(mail_root, seat["id"], "new")
        if not os.path.isdir(seat_maildir):
            init = os.path.join(os.path.dirname(os.path.abspath(__file__)), "agentmail-init")
            print(f"  FAILED    {seat['id']}   no maildir at {os.path.dirname(seat_maildir)}")
            print(f"            fix: {init} -d {mail_root} {seat['id']}")
            continue
        target = f"{seat['project']}:{seat['id']}" if seat.get("project") else seat["id"]
        _LAUNCH_CWDS[target] = seat["home"]
        good, detail = spawn(kind, seat["id"], build_command(seat, mail_root),
                             session=seat.get("project"))
        print(f"  {'launched' if good else 'FAILED  '}  {seat['id']}"
              + ("" if good else f"   {detail}"))
        ok += 1 if good else 0
        _log_launch_decision(seat, mail_root)  # never raises; see its own try/except
    print(f"\n{ok}/{len(chosen)} launched.")
    print("Each window is titled with its seat id. Confirm they are alive with:")
    print(f"  {os.path.join(os.path.dirname(os.path.abspath(__file__)), 'network-dashboard')}")
    return 0 if ok == len(chosen) else 1


if __name__ == "__main__":
    sys.exit(main())
