#!/usr/bin/env bash
# mail-check — list (and print) unread mail WITHOUT acknowledging.
# Usage: mail-check <agent-id> [--headers] [-d MAIL_DIR]
set -euo pipefail

MAIL_DIR="${AGENTMAIL_DIR:-.agent-mail}"
AGENT="" HEADERS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --headers) HEADERS=1; shift;;
    -d) MAIL_DIR="$2"; shift 2;;
    *) AGENT="$1"; shift;;
  esac
done
[ -n "$AGENT" ] || { echo "usage: mail-check <agent-id> [--headers]" >&2; exit 2; }

NEW="$MAIL_DIR/$AGENT/new"
[ -d "$NEW" ] || { echo "no such inbox: $NEW" >&2; exit 1; }

count=0
for f in "$NEW"/*.md; do
  [ -e "$f" ] || break
  count=$((count + 1))
  if [ "$HEADERS" = 1 ]; then
    subject="$(sed -n 's/^subject: //p' "$f" | head -1)"
    from="$(sed -n 's/^from: //p' "$f" | head -1)"
    echo "[$count] $(basename "$f")  —  $from: $subject"
  else
    echo "═══ $(basename "$f") ═══"
    cat "$f"
    echo ""
  fi
done
[ "$count" = 0 ] && echo "(no unread mail for $AGENT)"
exit 0
