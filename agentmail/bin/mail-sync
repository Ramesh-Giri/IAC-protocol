#!/usr/bin/env bash
# mail-sync — git federation daemon (FEDERATION.md §3).
# Commits local mail, pulls remote mail (rebase), pushes. Dumb by design:
# moves files, never reads them. Run persistently, or --once for cron/tests.
#
# Usage: mail-sync [-d MAIL_DIR] [-i INTERVAL_SECONDS] [--once]
set -euo pipefail

MAIL_DIR="${AGENTMAIL_DIR:-.agent-mail}"
INTERVAL=30
ONCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    -d) MAIL_DIR="$2"; shift 2;;
    -i) INTERVAL="$2"; shift 2;;
    --once) ONCE=1; shift;;
    *) echo "usage: mail-sync [-d dir] [-i seconds] [--once]" >&2; exit 2;;
  esac
done

git -C "$MAIL_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "mail-sync: $MAIL_DIR is not a git repository (see FEDERATION.md)" >&2; exit 1; }

# tmp/ must never travel between machines
GI="$MAIL_DIR/.gitignore"
grep -qxF '*/tmp/*' "$GI" 2>/dev/null || printf '*/tmp/*\n' >> "$GI"

# First-run bootstrap: a fresh clone (possibly of an empty remote) has no
# upstream. Seed the remote if it's empty; otherwise adopt its branch.
ensure_upstream() {
  git -C "$MAIL_DIR" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 && return 0
  git -C "$MAIL_DIR" fetch -q origin 2>/dev/null || true
  local rb
  rb="$(git -C "$MAIL_DIR" ls-remote --symref origin HEAD 2>/dev/null \
        | sed -n 's|^ref: refs/heads/\(.*\)	HEAD$|\1|p')"
  if [ -n "$rb" ] && git -C "$MAIL_DIR" rev-parse "origin/$rb" >/dev/null 2>&1; then
    if git -C "$MAIL_DIR" rev-parse HEAD >/dev/null 2>&1; then
      git -C "$MAIL_DIR" checkout -q -B "$rb"          # keep local commits
    else
      git -C "$MAIL_DIR" checkout -q -B "$rb" "origin/$rb"   # empty clone: adopt
    fi
    git -C "$MAIL_DIR" branch -q --set-upstream-to="origin/$rb" 2>/dev/null || true
  else
    git -C "$MAIL_DIR" push -q -u origin HEAD 2>/dev/null || true   # we seed
  fi
}

sync_cycle() {
  local host; host="$(hostname -s 2>/dev/null || echo local)"
  # 1. commit local changes first, so rebase never touches dirty files
  git -C "$MAIL_DIR" add -A
  if ! git -C "$MAIL_DIR" diff --cached --quiet 2>/dev/null; then
    git -C "$MAIL_DIR" commit -q -m "mail: $host $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fi
  ensure_upstream
  # 2. receive (rebase works even for unrelated histories)
  if git -C "$MAIL_DIR" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    git -C "$MAIL_DIR" pull -q --rebase 2>/dev/null || {
      echo "mail-sync: pull failed (offline? conflict?) — will retry" >&2; return 0; }
  fi
  # 3. publish, retrying once through a push race
  if ! git -C "$MAIL_DIR" push -q -u origin HEAD 2>/dev/null; then
    git -C "$MAIL_DIR" pull -q --rebase 2>/dev/null || true
    git -C "$MAIL_DIR" push -q -u origin HEAD 2>/dev/null || \
      echo "mail-sync: push failed — will retry next cycle" >&2
  fi
}

if [ "$ONCE" = 1 ]; then sync_cycle; exit 0; fi
echo "mail-sync: syncing $MAIL_DIR every ${INTERVAL}s"
while :; do sync_cycle; sleep "$INTERVAL"; done
