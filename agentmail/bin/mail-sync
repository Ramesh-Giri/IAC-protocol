#!/usr/bin/env python3
"""Synchronize a dedicated mail Git repository, never a nested product channel."""
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from iac import LOCAL_IGNORES, atomic_write, lock, parser, roster, run_bounded


def git(root, timeout, *args, check=True):
    result = run_bounded(["git", "-C", str(root), *args], timeout=timeout,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         env=dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_EDITOR="true"))
    if check and result.returncode:
        raise RuntimeError(f"git {args[0]} failed (exit {result.returncode}); inspect repository/upstream before retrying")
    return result


def cycle(root, timeout):
    # Guard before touching .gitignore, the index, or history.
    top = Path(git(root, timeout, "rev-parse", "--show-toplevel").stdout.strip()).resolve()
    if root != top:
        raise ValueError("mail-sync requires a dedicated mail repository; embedded product channels use manual scoped commits")
    roster(root)
    git(root, timeout, "remote", "get-url", "origin")
    with lock(root, "sync"), lock(root, "transport", wait=10):
        gitdir = Path(git(root, timeout, "rev-parse", "--absolute-git-dir").stdout.strip())
        if any((gitdir / x).exists() for x in ("rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD")):
            raise RuntimeError("Git operation unresolved; resolve it manually before syncing")
        # Whitelist the entire tracked payload, not just the directory name.
        names = git(root, timeout, "ls-files", "-z", "--cached", "--others", "--exclude-standard").stdout.split("\0")
        for name in filter(None, names):
            allowed = name in ("roster.json", ".gitignore") or re.fullmatch(r"[a-z0-9][a-z0-9_-]*/(?:new|cur)/(?:[^/]+\.md|\.keep)", name) or re.fullmatch(r"archive/(?:[^/]+\.md|\.keep)", name)
            local = name == "local.json" or name.startswith(".locks/") or re.fullmatch(r"[^/]+/(?:tmp/.*|bridge\.log)", name)
            if local and not git(root, timeout, "ls-files", "--error-unmatch", name, check=False).returncode:
                raise ValueError(f"machine-local state is tracked: {name}; untrack explicitly first")
            if not allowed and not local:
                raise ValueError(f"not a mail-only payload: {name}; nothing committed")
        ignore = root / ".gitignore"
        text = ignore.read_text() if ignore.exists() else ""
        additions = [x for x in LOCAL_IGNORES if x not in text.splitlines()]
        if additions:
            atomic_write(ignore, text.rstrip() + "\n" + "\n".join(additions) + "\n")
        git(root, timeout, "add", "--all", "--", ".")
        if git(root, timeout, "diff", "--cached", "--quiet", check=False).returncode:
            git(root, timeout, "commit", "-q", "-m", "mail: synchronize message and acknowledgement files")
        tracking = git(root, timeout, "rev-parse", "--abbrev-ref", "@{u}", check=False).returncode == 0
        if tracking:
            git(root, timeout, "pull", "--rebase")
        pushed = git(root, timeout, "push", "-u", "origin", "HEAD", check=False)
        if pushed.returncode:
            if not tracking:
                raise RuntimeError("push rejected; configure the intended upstream explicitly (no branch rewriting)")
            git(root, timeout, "pull", "--rebase")
            git(root, timeout, "push", "origin", "HEAD")


def main():
    p = parser("mail-sync")
    p.add_argument("--once", action="store_true")
    p.add_argument("-i", "--interval", type=float, default=30)
    p.add_argument("--timeout", type=float, default=45, help="maximum seconds per Git command")
    args = p.parse_args()
    if min(args.timeout, args.interval) <= 0:
        p.error("timeout and interval must be positive")
    root = Path(args.mail_root).resolve()
    while True:
        status = 0
        try:
            cycle(root, args.timeout)
        except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
            print(f"mail-sync: {exc}", file=sys.stderr, flush=True)
            status = 1
        if args.once:
            return status
        time.sleep(args.interval)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
