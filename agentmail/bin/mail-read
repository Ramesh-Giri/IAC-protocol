#!/usr/bin/env bash
# mail-read — print unread mail and acknowledge it (move new/ → cur/).
# The atomic move IS the ack (SPEC §3.2). Concurrent readers are safe:
# whoever's mv wins owns the read; the loser just skips.
# Usage: mail-read <agent-id> [-d MAIL_DIR]
set -euo pipefail

MAIL_DIR="${AGENTMAIL_DIR:-.agent-mail}"
AGENT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -d) MAIL_DIR="$2"; shift 2;;
    *) AGENT="$1"; shift;;
  esac
done
[ -n "$AGENT" ] || { echo "usage: mail-read <agent-id>" >&2; exit 2; }

NEW="$MAIL_DIR/$AGENT/new"
CUR="$MAIL_DIR/$AGENT/cur"
[ -d "$NEW" ] && [ -d "$CUR" ] || { echo "no such inbox: $MAIL_DIR/$AGENT" >&2; exit 1; }

count=0
for f in "$NEW"/*.md; do
  [ -e "$f" ] || break
  if mv "$f" "$CUR/" 2>/dev/null; then
    count=$((count + 1))
    echo "═══ $(basename "$f") ═══"
    cat "$CUR/$(basename "$f")"
    echo ""
  fi
done
[ "$count" = 0 ] && echo "(no unread mail for $AGENT)"
exit 0
