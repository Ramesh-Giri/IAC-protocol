#!/usr/bin/env python3
"""Report WHERE this agent is actually running: host app, TTY, tmux, job id.

An agent that cannot say where it runs will answer questions about the operator's
screen with facts about someone else's. 2026-09-12: asked which terminal it was
in, the overseer reported the only GUI terminal it could see -- which was the
FLEET's terminal, not its own. It was in fact a background job inside the desktop
app, attached to no terminal at all. Environment variables alone do not tell you:
a background session has no TERM_PROGRAM and no TMUX. Walk the process tree.
"""
from __future__ import annotations
import os, re, subprocess, sys

def ps(fmt: str, pid: int) -> str:
    try:
        return subprocess.run(["ps", "-o", fmt, "-p", str(pid)],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""

def ancestry(pid: int, limit: int = 15):
    chain = []
    for _ in range(limit):
        line = ps("ppid=,comm=", pid)
        if not line:
            break
        parts = line.split(None, 1)
        if len(parts) < 2:
            break
        ppid, comm = int(parts[0]), parts[1]
        chain.append((pid, comm))
        if ppid <= 1:
            break
        pid = ppid
    return chain

def main() -> int:
    chain = ancestry(os.getpid())
    host, detail = "unknown", ""
    for _pid, comm in chain:
        low = comm.lower()
        if "claudecode.app" in low:
            host = "Claude Code desktop app"; break
        if "iterm" in low:
            host = "iTerm2"; break
        if "terminal.app" in low or low.endswith("/terminal"):
            host = "macOS Terminal.app"; break
        for name in ("ghostty", "warp", "kitty", "alacritty", "wezterm", "code helper", "vscode"):
            if name in low:
                host = comm; break
        else:
            continue
        break

    top = chain[-1][0] if chain else os.getpid()
    cmd = ps("command=", top)
    bg = "--bg-pty-host" in cmd
    job = ""
    m = re.search(r"/pty/([0-9a-f-]+)\.sock", cmd)
    if m:
        job = m.group(1)

    # The OPERATOR-facing client and the JOB HOST are different processes, and
    # confusing them is how "which terminal are you on?" gets answered wrongly.
    # A genuine terminal window has a `login` session leader on its tty; a
    # daemon-allocated PTY (a background job) does not. Report BOTH.
    def _session_tty() -> str:
        for pid_, _c in chain:
            t_ = ps("tty=", pid_)
            if t_ and t_ != "??":
                return t_
        return "??"

    def _is_real_window(tty_: str) -> bool:
        if not tty_ or tty_ == "??":
            return False
        try:
            out = subprocess.run(["ps", "-eo", "tty=,comm="], capture_output=True,
                                 text=True, timeout=5).stdout
        except Exception:
            return False
        return any(l.split()[0] == tty_ and l.split()[-1].endswith("login")
                   for l in out.splitlines() if l.split())

    tty = _session_tty()
    real = _is_real_window(tty)
    print(f"tty (session): {tty}  ->  {'genuine terminal window' if real else 'daemon PTY / no window'}")

    # DO NOT guess which session is the operator's. Other agent CLIs on real
    # terminals are usually OTHER sessions (old, or the fleet), and naming one as
    # "the operator's client" is an unfounded claim dressed as a reading. List
    # them as what they are: other sessions.
    try:
        allp = subprocess.run(["ps", "-eo", "pid=,tty=,comm="], capture_output=True,
                              text=True, timeout=5).stdout
        others = [l.strip() for l in allp.splitlines()
                  if len(l.split()) >= 3 and l.split()[1] != "??"
                  and l.split()[-1].split("/")[-1] in ("claude", "codex")
                  and l.split()[1] != tty]
        if others:
            print("other agent sessions on real terminals (NOT necessarily this one):")
            for c in others:
                print(f"  {c}")
    except Exception:
        pass

    # WHICH terminal app owns a tty: resolve the `login` leader's PARENT.
    # Both Terminal.app and iTerm2 spawn `login`, so the presence of a login
    # leader says "a real window" and says NOTHING about which app -- inferring
    # Terminal.app from it named the wrong application twice on 2026-09-12.
    def _tty_owner(tty_: str) -> str:
        try:
            rows = subprocess.run(["ps", "-eo", "pid=,tty=,comm="], capture_output=True,
                                  text=True, timeout=5).stdout.splitlines()
        except Exception:
            return "unknown"
        for r in rows:
            f = r.split()
            if len(f) >= 3 and f[1] == tty_ and f[-1].endswith("login"):
                pp = ps("ppid=", int(f[0])).strip()
                if pp:
                    owner = ps("comm=", int(pp))
                    low = owner.lower()
                    if "itermserver" in low or "iterm" in low:
                        return "iTerm2"
                    if "terminal" in low:
                        return "macOS Terminal.app"
                    return owner.split("/")[-1] or "unknown"
        return "no window (daemon PTY)"

    print(f"tty owner    : {_tty_owner(tty)}")
    if bg:
        # A background job's own PTY has no owning app; the ORIGINATING terminal is
        # where the operator actually sits. Report it, labelled as an inference.
        owners = set()
        try:
            rows = subprocess.run(["ps", "-eo", "pid=,tty=,comm="], capture_output=True,
                                  text=True, timeout=5).stdout.splitlines()
            for r in rows:
                f = r.split()
                if len(f) >= 3 and f[1] != "??" and f[-1].split("/")[-1] in ("claude", "codex"):
                    o = _tty_owner(f[1])
                    if o not in ("unknown", "no window (daemon PTY)"):
                        owners.add(o)
        except Exception:
            pass
        if owners:
            print(f"likely operator terminal: {', '.join(sorted(owners))}"
                  "  (inferred from interactive agent sessions, not proven)")
    print(f"host app     : {host}")
    print(f"session kind : {'BACKGROUND job (no terminal attached)' if bg else 'foreground'}")
    if job:
        print(f"job id       : {job}")
    print(f"tty          : {tty}")
    print(f"TERM_PROGRAM : {os.environ.get('TERM_PROGRAM', '<unset>')}")
    print(f"inside tmux  : {'yes -> ' + os.environ['TMUX'].split(',')[0] if os.environ.get('TMUX') else 'no'}")
    print("\nprocess ancestry (nearest first):")
    for pid_, comm in chain:
        print(f"  {pid_:>7}  {comm}")
    if bg:
        print("\nNOTE: a background session is invisible to the operator. Do not report"
              "\nanother process's terminal as your own, and do not claim a fleet is"
              "\n'running' on the strength of a session nobody can see (rule 13).")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
