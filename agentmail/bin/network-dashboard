#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""network-dashboard — render the AgentMail network as one self-contained HTML
instrument panel.

This file is only the entry point. The project lives in ../dashboard:

    agentmail/dashboard/
        README.md              what the page promises and how to read it
        netdash/               the package (thresholds -> util -> probes ->
                               state -> glyphs -> model -> panels -> page)
        netdash/static/        dashboard.css, dashboard.js (real files,
                               inlined into the output at build time)
        tests/                 python3 -m unittest discover

Usage:  network-dashboard [-o OUT.html] [--json SNAPSHOT.json] [--hours N]
                          [--mail-root DIR] [--snapshot-bin PATH] [--quiet]
"""

import os
import sys

_DASHBOARD = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "dashboard")
if _DASHBOARD not in sys.path:
    sys.path.insert(0, _DASHBOARD)

try:
    from netdash.cli import main
except ImportError as exc:  # a broken checkout should say so, not traceback
    sys.stderr.write(f"network-dashboard: cannot import the netdash package from {_DASHBOARD}: {exc}\n")
    sys.exit(2)

if __name__ == "__main__":
    sys.exit(main())
