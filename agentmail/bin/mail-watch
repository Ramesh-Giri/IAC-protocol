#!/usr/bin/env bash
# mail-watch — emit one line per message arriving in new/. Replay-proof by
# construction: it only ever sees unread mail (SPEC §7). Runs until killed.
# Uses fswatch (macOS) or inotifywait (Linux) when available; falls back to
# a poll. Emits "MAIL <agent> <filename> — <from>: <subject>" per message.
# Usage: mail-watch <agent-id> [-d MAIL_DIR]
set -euo pipefail

MAIL_DIR="${AGENTMAIL_DIR:-.agent-mail}"
AGENT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -d) MAIL_DIR="$2"; shift 2;;
    *) AGENT="$1"; shift;;
  esac
done
[ -n "$AGENT" ] || { echo "usage: mail-watch <agent-id>" >&2; exit 2; }

NEW="$MAIL_DIR/$AGENT/new"
[ -d "$NEW" ] || { echo "no such inbox: $NEW" >&2; exit 1; }

announce() { # $1 = path to message file
  [ -e "$1" ] || return 0
  local from subject
  from="$(sed -n 's/^from: //p' "$1" | head -1)"
  subject="$(sed -n 's/^subject: //p' "$1" | head -1)"
  echo "MAIL $AGENT $(basename "$1") — ${from:-?}: ${subject:-?}"
}

# Announce anything already waiting (these are genuinely unread — not replay)
for f in "$NEW"/*.md; do [ -e "$f" ] || break; announce "$f"; done

if command -v fswatch >/dev/null 2>&1; then
  fswatch --event Created --event MovedTo -0 "$NEW" | while IFS= read -r -d '' path; do
    case "$path" in *.md) announce "$path";; esac
  done
elif command -v inotifywait >/dev/null 2>&1; then
  inotifywait -m -q -e moved_to -e create --format '%w%f' "$NEW" | while IFS= read -r path; do
    case "$path" in *.md) announce "$path";; esac
  done
else
  # Poll fallback: track what we've announced this run
  seen="$(mktemp)"; trap 'rm -f "$seen"' EXIT
  for f in "$NEW"/*.md; do [ -e "$f" ] || break; basename "$f" >> "$seen"; done
  while sleep 5; do
    for f in "$NEW"/*.md; do
      [ -e "$f" ] || break
      b="$(basename "$f")"
      grep -qxF "$b" "$seen" 2>/dev/null || { announce "$f"; echo "$b" >> "$seen"; }
    done
  done
fi
