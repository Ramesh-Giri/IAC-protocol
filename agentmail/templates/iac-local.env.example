# Copy to IAC_ROOT/.iac-local.env (ignored); set IAC_ROOT to your clone before sourcing.
# Change dev to your own approved lowercase owner/site alias; no credentials here.
export IAC_OWNER=dev
export IAC_SITE="$IAC_OWNER"
export IAC_MAIN_SEAT="overseer-$IAC_OWNER"
export AGENTMAIL_DIR="$IAC_ROOT/.agent-mail"
export AGENTMAIL_SITE="$IAC_SITE"
export PATH="$IAC_ROOT/agentmail/bin:$PATH"
export IAC_TEST_QUEUE="$IAC_ROOT/.agent-mail/testlane"
# Existing-site legacy wrapper only; new sites use the tracked testlane runner.
export IAC_HEAVY="$IAC_ROOT/.agent-mail/attachments/shared-tests/heavy.sh"
